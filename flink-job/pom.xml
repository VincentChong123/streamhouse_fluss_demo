<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>demo.paymentrisk</groupId>
    <artifactId>payment-risk-streamhouse-demo</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>flink-job</artifactId>
  <name>flink-job: bounded processing (Kafka to Kafka) and ingestion (Kafka to Fluss) jobs</name>

  <dependencies>
    <dependency>
      <groupId>demo.paymentrisk</groupId>
      <artifactId>common</artifactId>
    </dependency>

    <!-- Provided by the Flink image (flink-dist and flink-table-api-java-uber in /opt/flink/lib). -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-streaming-java</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-table-api-java-bridge</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-connector-base</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The Fluss connector (fluss-flink-1.20-1.0.0.jar) is also in /opt/flink/lib. The job reaches
         it only through SQL (CREATE CATALOG ... 'type'='fluss'), so no compile dependency is needed. -->

    <!-- The Kafka connector is NOT bundled: the jobs use it only through Table API DDL, and the
         one copy is flink-sql-connector-kafka in /opt/flink/lib (see docker/flink/Dockerfile),
         shared with the SQL Gateway. -->

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>flink-job</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <excludes>
                  <!-- Already on Flink's classpath: never ship a second copy. -->
                  <exclude>org.apache.flink:flink-shaded-*</exclude>
                  <exclude>org.apache.flink:flink-connector-base</exclude>
                  <exclude>org.apache.flink:flink-annotations</exclude>
                  <exclude>com.google.code.findbugs:jsr305</exclude>
                  <exclude>org.slf4j:*</exclude>
                  <exclude>org.apache.logging.log4j:*</exclude>
                  <!-- Native compression codecs: the Fluss connector in /opt/flink/lib already ships
                       zstd/lz4, and loading a JNI library from two classloaders fails. The demo
                       producer sends uncompressed records, so Kafka never needs them. -->
                  <exclude>com.github.luben:zstd-jni</exclude>
                  <exclude>org.lz4:lz4-java</exclude>
                  <exclude>org.xerial.snappy:snappy-java</exclude>
                </excludes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>demo.paymentrisk.flink.PaymentRiskJob</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
