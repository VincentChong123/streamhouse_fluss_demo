{
  "id": "benign-known-device",
  "order": 2,
  "title": "Benign: change made from a known device",
  "variant": "Benign: known device",
  "summary": "Same bank change and payment, but the modification came from a device the identity provider already knows. The rule does not match.",
  "ui": false,
  "supplier_id": "SUP-NORTHSTAR",
  "payment_id": "PAY-NS-0001",
  "expected_final": {
    "supplier": { "context_version": 3, "signal_band": "ELEVATED", "unfamiliar_device_evidence": false },
    "review": {
      "outcome": "NO_RULE_MATCH", "context_version_used": 3,
      "check_recent_change": "TRUE", "check_unfamiliar_device": "FALSE", "check_large_payment": "TRUE"
    }
  },
  "steps": [
    {
      "id": "baseline", "label": "Supplier baseline", "event_type": "SUPPLIER_REGISTERED", "business_offset_seconds": 0,
      "caption": "Northstar Logistics: three-year relationship, established account •••• 1842.",
      "notice": "Context v1, band NORMAL.",
      "payload": { "source_system": "simulated-vendor-master", "supplier_name": "Northstar Logistics", "relationship_years": 3, "beneficiary_masked": "•••• 1842", "recurring_amount_minor": 7500000, "currency": "USD" },
      "expect": { "disposition": "APPLIED", "context_version": 1, "signal_band": "NORMAL" }
    },
    {
      "id": "bank-change", "label": "Beneficiary change", "event_type": "BENEFICIARY_CHANGED", "business_offset_seconds": 60,
      "caption": "Bank details change to •••• 9077 (simulated CDC-shaped event).",
      "notice": "Context v2, band ELEVATED while identity evidence is pending.",
      "payload": { "source_system": "simulated-vendor-master-cdc", "cdc": { "op": "u", "table": "vendor_master.supplier_bank_account", "simulated": true }, "change_id": "CHG-1001", "actor_id": "usr-ap-clerk-17", "session_id": "sess-4f2a", "before": { "beneficiary_masked": "•••• 1842" }, "after": { "beneficiary_masked": "•••• 9077" } },
      "expect": { "disposition": "APPLIED", "context_version": 2, "signal_band": "ELEVATED" }
    },
    {
      "id": "identity", "label": "Identity activity (known device)", "event_type": "IDENTITY_ACTIVITY", "business_offset_seconds": 120,
      "caption": "The identity provider links this modification to the clerk's usual, known laptop.",
      "notice": "Context v3: evidence recorded, no unfamiliar device. Band stays ELEVATED (a change happened), not HIGH.",
      "payload": { "source_system": "simulated-identity-provider", "change_id": "CHG-1001", "actor_id": "usr-ap-clerk-17", "session_id": "sess-4f2a", "device_id": "dev-ap-laptop-0412", "device_is_known": true, "activity": "BANK_DETAILS_MODIFIED" },
      "expect": { "disposition": "APPLIED", "context_version": 3, "signal_band": "ELEVATED" }
    },
    {
      "id": "payment", "label": "Payment request", "event_type": "PAYMENT_REQUESTED", "business_offset_seconds": 180,
      "caption": "A USD 75,000 payment to •••• 9077 is requested.",
      "notice": "unfamiliar_device is FALSE, so NO_RULE_MATCH: \"No match for this demo rule\". That is not an authorization.",
      "payload": { "source_system": "simulated-payments-hub", "payment_id": "PAY-NS-0001", "amount_minor": 7500000, "currency": "USD", "beneficiary_masked": "•••• 9077" },
      "expect": { "disposition": "REVIEWED", "outcome": "NO_RULE_MATCH" }
    }
  ]
}
