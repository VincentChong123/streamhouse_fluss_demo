{
  "id": "benign-stale-change",
  "order": 5,
  "title": "Benign: change older than ten business minutes",
  "variant": "Benign: change older than 10 minutes",
  "summary": "The same suspicious change and unseen device, but the payment is requested eleven business minutes after the change. The band stays HIGH (latest observed signals), yet the rule's time condition is false.",
  "ui": false,
  "supplier_id": "SUP-NORTHSTAR",
  "payment_id": "PAY-NS-0003",
  "expected_final": {
    "supplier": { "context_version": 3, "signal_band": "HIGH" },
    "review": {
      "outcome": "NO_RULE_MATCH", "context_version_used": 3, "seconds_since_bank_change": 660,
      "check_recent_change": "FALSE", "check_unfamiliar_device": "TRUE", "check_large_payment": "TRUE"
    }
  },
  "steps": [
    {
      "id": "baseline", "label": "Supplier baseline", "event_type": "SUPPLIER_REGISTERED", "business_offset_seconds": 0,
      "caption": "Northstar Logistics: three-year relationship, established account •••• 1842.",
      "notice": "Context v1, band NORMAL.",
      "payload": { "source_system": "simulated-vendor-master", "supplier_name": "Northstar Logistics", "relationship_years": 3, "beneficiary_masked": "•••• 1842", "recurring_amount_minor": 7500000, "currency": "USD" },
      "expect": { "disposition": "APPLIED", "context_version": 1, "signal_band": "NORMAL" }
    },
    {
      "id": "bank-change", "label": "Beneficiary change", "event_type": "BENEFICIARY_CHANGED", "business_offset_seconds": 60,
      "caption": "Bank details change to •••• 9077 (simulated CDC-shaped event).",
      "notice": "Context v2, band ELEVATED.",
      "payload": { "source_system": "simulated-vendor-master-cdc", "cdc": { "op": "u", "table": "vendor_master.supplier_bank_account", "simulated": true }, "change_id": "CHG-1001", "actor_id": "usr-ap-clerk-17", "session_id": "sess-4f2a", "before": { "beneficiary_masked": "•••• 1842" }, "after": { "beneficiary_masked": "•••• 9077" } },
      "expect": { "disposition": "APPLIED", "context_version": 2, "signal_band": "ELEVATED" }
    },
    {
      "id": "identity", "label": "Identity activity", "event_type": "IDENTITY_ACTIVITY", "business_offset_seconds": 120,
      "caption": "The modification came from a previously unseen device.",
      "notice": "Context v3, band HIGH.",
      "payload": { "source_system": "simulated-identity-provider", "change_id": "CHG-1001", "actor_id": "usr-ap-clerk-17", "session_id": "sess-4f2a", "device_id": "dev-7c1e-unseen", "device_is_known": false, "activity": "BANK_DETAILS_MODIFIED" },
      "expect": { "disposition": "APPLIED", "context_version": 3, "signal_band": "HIGH" }
    },
    {
      "id": "payment", "label": "Payment request (+11 business min)", "event_type": "PAYMENT_REQUESTED", "business_offset_seconds": 720,
      "caption": "A USD 75,000 payment arrives eleven business minutes after the change (replayed a few seconds later in wall-clock time).",
      "notice": "recent_change is evaluated against the payment's business time: 660 s > 600 s, so FALSE. NO_RULE_MATCH, although the stored band is still HIGH.",
      "payload": { "source_system": "simulated-payments-hub", "payment_id": "PAY-NS-0003", "amount_minor": 7500000, "currency": "USD", "beneficiary_masked": "•••• 9077" },
      "expect": { "disposition": "REVIEWED", "outcome": "NO_RULE_MATCH" }
    }
  ]
}
